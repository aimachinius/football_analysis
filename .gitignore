*.onnx
*.weights
*.safetensors

# === Stubs / Detection Cache ===
stubs/

# === Dataset & Raw Data ===
data/
NewData/
data.yaml

# === Input & Output Videos ===
video/
output/*
!output/output_sota.mp4
!output/output_sota_minimap.mp4
*.mp4
!output/output_sota*.mp4
*.avi
*.mov
*.mkv

